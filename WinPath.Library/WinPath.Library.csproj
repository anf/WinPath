<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<Version>0.2.1</Version>
		<Authors>ANF-Studios</Authors>
		<Title>WinPath.Library</Title>
		<Description>WinPath's core library, for others to use!</Description>
		<RepositoryUrl>https://github.com/ANF-Studios/WinPath</RepositoryUrl>
		<PackageProjectUrl>https://github.com/ANF-Studios/WinPath/tree/master/WinPath.Library</PackageProjectUrl>
		<PackageLicenseFile>license.txt</PackageLicenseFile>
		<PackageTags>WinPath;Environment;Windows</PackageTags>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<None Include="license.txt" Pack="true" PackagePath="" />
	</ItemGroup>

</Project>
